# settings (passo 04)
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000
BEHIND_TLS_PROXY=False
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
OIDC_RSA_PRIVATE_KEY=

# compose (passo 02) — POSTGRES_PORT e REDIS_PORT sao as portas publicadas no host.
POSTGRES_DB=nova_api
POSTGRES_USER=nova_api
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# enderecos da jornada de construcao: quem se conecta e o runserver no host.
# Nao servem dentro do container — o passo 11 sobrescreve as duas em environment:.
# Coerencia manual, sem mecanismo que a verifique.
# DATABASE_URL deriva de POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB e POSTGRES_PORT.
DATABASE_URL=postgres://nova_api:SENHA@localhost:5432/nova_api
# REDIS_URL deriva de REDIS_PORT.
REDIS_URL=redis://localhost:6379/0

# entrypoint (passo 11) — o superusuario so e criado se as duas forem definidas.
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
