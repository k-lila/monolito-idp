# settings (passo 04)
DEBUG=False
SECRET_KEY=
# As três abaixo são os valores da JORNADA DE CONSTRUÇÃO, e só dela: o
# docker-compose.yml sobrescreve as três no serviço `app`, derivando-as de PUBLIC_HOST,
# porque atrás do proxy o IdP fala https no nome público e aqui o runserver fala texto
# claro em localhost (ADR 0017).
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000
BEHIND_TLS_PROXY=False
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
OIDC_RSA_PRIVATE_KEY=
# Trilha de auditoria. Caminho relativo ao diretório de trabalho do processo; o
# docker-compose.yml a sobrescreve por um absoluto, dentro do volume nomeado auditlog.
AUDIT_LOG_PATH=logs/audit.log
# Origem da SPA, destino do botão "Ir para a aplicação" da home. Só esquema, host e
# porta opcional: sem caminho, barra final, query, fragmento ou credenciais. Em produção é
# https://<origem da SPA>, o mesmo valor da entrada de CORS_ALLOWED_ORIGINS, e nada confere
# que as duas coincidam. Sem default: ausente, derruba o boot nomeando a si mesma. Com
# BEHIND_TLS_PROXY verdadeiro, http:// só é aceito em loopback (localhost, 127.0.0.1, ::1).
# Com BASE_URL público, isto é, fora de localhost, 127.0.0.1, ::1 e de nomes sob .localhost,
# a guarda de produção recusa loopback no boot, nomeando a variável.
SPA_URL=http://localhost:5173
# O client_id da Application da SPA neste ambiente, copiado do admin: a API de conta (ADR 0031)
# só aceita token emitido para ela. Sem default: ausente ou vazia, derruba o boot nomeando a si
# mesma. Errada, nada derruba: toda chamada à API recebe 403 aplicacao_nao_autorizada.
SPA_CLIENT_ID=trocar-pelo-client-id-da-spa
# Envio de e-mail (ADR 0031). Sem default: ausente, cada uma derruba o boot nomeando a si mesma.
# Os valores abaixo são os de desenvolvimento: o backend de console escreve a mensagem inteira
# no stdout e não abre conexão nenhuma, e por isso host, porta e credenciais não são usados.
# Em produção, o backend é django.core.mail.backends.smtp.EmailBackend, com os dados da conta
# SMTP. Com BASE_URL público, a guarda de produção recusa no boot o de console e os outros que
# não entregam (dummy, locmem, filebased), nomeando a variável.
# EMAIL_TIMEOUT é em segundos. DEFAULT_FROM_EMAIL é o remetente que a pessoa vê.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=IdP <nao-responda@localhost>

# compose (passo 02) — POSTGRES_PORT e REDIS_PORT são as portas publicadas no host.
# POSTGRES_DB e POSTGRES_USER são identificadores presos ao volume de dados do Postgres, não o
# nome do projeto: trocá-los num clone que já tem volume deixa o banco existente inacessível.
POSTGRES_DB=nova_api
POSTGRES_USER=nova_api
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
# Senha do Redis, usada em três pontos do docker-compose.yml — o `--requirepass` do
# servidor, o REDISCLI_AUTH do healthcheck e a REDIS_URL do container — e aqui, na
# REDIS_URL da jornada de construção. Um valor só, para que servidor e cliente não possam
# divergir.
#
# O ./scripts/gen_env_secrets.sh a gera em hexadecimal, que não tem `@`, `:`, `/` nem `#`, e
# qualquer um dos quatro quebra a URL — o erro que sai fala de host ou de porta, nunca de senha.
# Vazia é o mesmo que ausente: `${REDIS_PASSWORD:?}` segue a convenção do shell e aborta o
# `up` nos dois casos, nomeando a variável. O que ninguém confere é se a senha repetida na
# REDIS_URL abaixo é esta — a divergência aparece na primeira operação de cache.
REDIS_PASSWORD=

# Nome público pelo qual o proxy atende, e do qual o compose deriva BASE_URL,
# ALLOWED_HOSTS e o certificado (ADR 0017). É o único literal de host em arquivo versionado
# deste repositório, e é de exemplo: `.localhost` é reservado pela RFC 6761 e não pode virar
# um host real por descuido. O navegador o resolve em 127.0.0.1 sozinho; fora do navegador
# a resolução depende do nsswitch do host, e o README traz a linha de /etc/hosts.
# O nome é provisório por escolha, até a primeira relying party integrada: com ele muda o
# issuer, que fica cacheado em cada uma (ADR 0007), e o HSTS (HTTP Strict Transport Security)
# marca o navegador de quem visitar. A razão inteira está em docs/receita.md.
PUBLIC_HOST=idp.localhost

# endereços da jornada de construção: quem se conecta é o runserver no host.
# Não servem dentro do container — o passo 11 sobrescreve as duas em environment:.
# Coerência manual, sem mecanismo que a verifique.
# DATABASE_URL deriva de POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB e POSTGRES_PORT.
DATABASE_URL=postgres://nova_api:SENHA@localhost:5432/nova_api
# REDIS_URL deriva de REDIS_PASSWORD e de REDIS_PORT. O usuário é vazio — os dois pontos
# depois de `//` não são erro de digitação: o Redis sob `requirepass` autentica só por senha.
REDIS_URL=redis://:SENHA@localhost:6379/0

# Só no clone de produção (ADR 0027). As duas linhas ficam comentadas aqui e são descomentadas
# no `.env` do clone de produção, e em nenhum outro. O `docker-compose.prod.yml` exige as duas e
# aborta nomeando a que faltar.
#
# COMPOSE_PROJECT_NAME é o que separa produção de desenvolvimento na mesma máquina. Descomentada
# num `.env` de desenvolvimento, faz o Compose de desenvolvimento adotar os contêineres e os
# volumes de produção sem aviso, e um `down -v` ali apaga o `pgdata` de produção. No ensaio e na
# restauração que não substitui produção, o nome é outro, nem o de produção nem o de
# desenvolvimento (ADR 0027, "Restauração").
#
# TUNNEL_ID é o identificador (UUID, de Universally Unique Identifier) do túnel, entregue por
# quem opera. Sozinho não é segredo: o segredo é `cloudflared/credenciais.json`, o arquivo de
# credenciais do mesmo túnel, que o `.gitignore` e o `.dockerignore` barram.
# COMPOSE_PROJECT_NAME=nova_api_prod
# TUNNEL_ID=
