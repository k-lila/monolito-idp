# settings (passo 04)
DEBUG=False
SECRET_KEY=
# As três abaixo são os valores da JORNADA DE CONSTRUÇÃO, e só dela: o
# docker-compose.yml sobrescreve as três no serviço `app`, derivando-as de PUBLIC_HOST,
# porque atrás do proxy o IdP fala https no nome público e aqui o runserver fala texto
# claro em localhost (ADR 0017).
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000
BEHIND_TLS_PROXY=False
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
OIDC_RSA_PRIVATE_KEY=
# Trilha de auditoria. Caminho relativo ao diretório de trabalho do processo; o
# docker-compose.yml a sobrescreve por um absoluto, dentro do volume nomeado auditlog.
AUDIT_LOG_PATH=logs/audit.log

# compose (passo 02) — POSTGRES_PORT e REDIS_PORT são as portas publicadas no host.
POSTGRES_DB=nova_api
POSTGRES_USER=nova_api
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
# Senha do Redis, usada em três pontos do docker-compose.yml — o `--requirepass` do
# servidor, o REDISCLI_AUTH do healthcheck e a REDIS_URL do container — e aqui, na
# REDIS_URL da jornada de construção. Um valor só, para que servidor e cliente não possam
# divergir.
#
# Gere com `openssl rand -hex 32`: hexadecimal não tem `@`, `:`, `/` nem `#`, e qualquer
# um dos quatro quebra a URL — o erro que sai fala de host ou de porta, nunca de senha.
# Vazia é o mesmo que ausente: `${REDIS_PASSWORD:?}` segue a convenção do shell e aborta o
# `up` nos dois casos, nomeando a variável. O que ninguém confere é se a senha repetida na
# REDIS_URL abaixo é esta — a divergência aparece na primeira operação de cache.
REDIS_PASSWORD=

# Nome público pelo qual o proxy atende, e do qual o compose deriva BASE_URL,
# ALLOWED_HOSTS e o certificado (ADR 0017). É o único literal de host em arquivo versionado
# deste repositório, e é de exemplo: `.localhost` é reservado pela RFC 6761 e não pode virar
# um host real por descuido. O navegador o resolve em 127.0.0.1 sozinho; fora do navegador
# a resolução depende do nsswitch do host, e o README traz a linha de /etc/hosts.
# O nome é provisório por escolha, até a primeira relying party integrada: com ele muda o
# issuer, que fica cacheado em cada uma (ADR 0007), e o HSTS (HTTP Strict Transport Security)
# marca o navegador de quem visitar. A razão inteira está em docs/receita.md.
PUBLIC_HOST=idp.localhost

# endereços da jornada de construção: quem se conecta é o runserver no host.
# Não servem dentro do container — o passo 11 sobrescreve as duas em environment:.
# Coerência manual, sem mecanismo que a verifique.
# DATABASE_URL deriva de POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB e POSTGRES_PORT.
DATABASE_URL=postgres://nova_api:SENHA@localhost:5432/nova_api
# REDIS_URL deriva de REDIS_PASSWORD e de REDIS_PORT. O usuário é vazio — os dois pontos
# depois de `//` não são erro de digitação: o Redis sob `requirepass` autentica só por senha.
REDIS_URL=redis://:SENHA@localhost:6379/0
